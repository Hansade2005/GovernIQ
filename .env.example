# PiPilot (auth)
VITE_PIPILOT_ANON_KEY=""

# Supabase (document storage + registry metadata)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Optional: a free Pollinations key (https://auth.pollinations.ai) switches
# the assistant to that provider — roughly 1s per answer instead of ~10s.
# Leave blank to stay on the keyless unturf endpoint.
VITE_POLLINATIONS_KEY=""
VITE_POLLINATIONS_MODEL="openai"

# Optional: pin a g4f model instead of 'auto'. Must be the full
# server-qualified form, e.g. "srv_xxxx:deepseek-v4-pro" — plain aliases 404.
VITE_G4F_MODEL=""
